{
  "info": {
    "name": "Промавтоматика · 1С → API документів",
    "description": "Перевірка інтеграції: логін, надсилання документа, повторне надсилання тим самим номером, перевірка статусу, відмова без токена. Перед запуском імпортуйте оточення і впишіть пароль у змінну password.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Логін",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{apikey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/auth/v1/token?grant_type=password",
          "host": ["{{base_url}}"],
          "path": ["auth", "v1", "token"],
          "query": [{ "key": "grant_type", "value": "password" }]
        },
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', function () { pm.response.to.have.status(200); });",
              "var j = pm.response.json();",
              "pm.test('Прийшов access_token', function () { pm.expect(j.access_token).to.be.a('string'); });",
              "pm.environment.set('access_token', j.access_token);",
              "pm.environment.set('refresh_token', j.refresh_token);",
              "console.log('Токен діє секунд: ' + j.expires_in);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Надіслати документ",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{apikey}}" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/rest/v1/rpc/ingest_1c_doc",
          "host": ["{{base_url}}"],
          "path": ["rest", "v1", "rpc", "ingest_1c_doc"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"p_payload\": {\n    \"doc_id\": \"{{doc_id}}\",\n    \"doc_type\": \"spec\",\n    \"doc_date\": \"2026-10-27\",\n    \"counterparty\": \"ТОВ «Приклад»\",\n    \"manager\": \"Вельгус\",\n    \"total\": 137650.50,\n    \"currency\": \"UAH\",\n    \"items\": [\n      {\n        \"line_no\": 1,\n        \"item_code\": \"BAT-SE-F16\",\n        \"item_name\": \"Акумуляторна батарея DEYE SE-F16-С LiFePO4 LV 51.2V 314Ah 16kWh\",\n        \"unit\": \"шт\",\n        \"qty\": 1,\n        \"price\": 94210.50,\n        \"amount\": 94210.50\n      },\n      {\n        \"line_no\": 2,\n        \"item_code\": \"INV-SUN6K\",\n        \"item_name\": \"Інвертор гібридний 6 кВт SUN-6K-SG05LP1-EU DEYE\",\n        \"unit\": \"шт\",\n        \"qty\": 1,\n        \"price\": 43440.00,\n        \"amount\": 43440.00\n      }\n    ]\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', function () { pm.response.to.have.status(200); });",
              "var j = pm.response.json();",
              "pm.test('ok = true', function () { pm.expect(j.ok).to.eql(true); });",
              "pm.test('Прийнято 2 позиції', function () { pm.expect(j.items).to.eql(2); });",
              "console.log('Документ ' + j.doc_id + ': ' + j.action + ', позицій ' + j.items);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Повторне надсилання того самого номера",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{apikey}}" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/rest/v1/rpc/ingest_1c_doc",
          "host": ["{{base_url}}"],
          "path": ["rest", "v1", "rpc", "ingest_1c_doc"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"p_payload\": {\n    \"doc_id\": \"{{doc_id}}\",\n    \"doc_type\": \"spec\",\n    \"counterparty\": \"ТОВ «Приклад»\",\n    \"note\": \"виправлена версія, одна позиція\",\n    \"items\": [\n      {\n        \"item_code\": \"BAT-SE-F16\",\n        \"item_name\": \"Акумуляторна батарея DEYE SE-F16-С 16kWh\",\n        \"unit\": \"шт\",\n        \"qty\": 2,\n        \"price\": 94210.50,\n        \"amount\": 188421.00\n      }\n    ]\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', function () { pm.response.to.have.status(200); });",
              "var j = pm.response.json();",
              "pm.test('Документ оновлено, а не задвоєно', function () { pm.expect(j.action).to.eql('updated'); });",
              "pm.test('Позиції перезаписані: лишилась одна', function () { pm.expect(j.items).to.eql(1); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Перевірити статус документа",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{apikey}}" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/rest/v1/rpc/ingest_1c_status",
          "host": ["{{base_url}}"],
          "path": ["rest", "v1", "rpc", "ingest_1c_status"]
        },
        "body": { "mode": "raw", "raw": "{\n  \"p_doc_id\": \"{{doc_id}}\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', function () { pm.response.to.have.status(200); });",
              "var j = pm.response.json();",
              "pm.test('Документ знайдено', function () { pm.expect(j.found).to.eql(true); });",
              "pm.test('Позицій одна', function () { pm.expect(j.items).to.eql(1); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Помилка: не вказано doc_id",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{apikey}}" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/rest/v1/rpc/ingest_1c_doc",
          "host": ["{{base_url}}"],
          "path": ["rest", "v1", "rpc", "ingest_1c_doc"]
        },
        "body": { "mode": "raw", "raw": "{\n  \"p_payload\": { \"doc_type\": \"spec\", \"items\": [] }\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Запит відхилено', function () { pm.expect(pm.response.code).to.be.above(399); });",
              "pm.test('Зрозуміла причина', function () { pm.expect(pm.response.text()).to.include('doc_id'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Без токена має бути відмова",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{apikey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/rest/v1/rpc/ingest_1c_doc",
          "host": ["{{base_url}}"],
          "path": ["rest", "v1", "rpc", "ingest_1c_doc"]
        },
        "body": { "mode": "raw", "raw": "{\n  \"p_payload\": { \"doc_id\": \"NO-TOKEN\", \"items\": [] }\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Запит без токена відхилено', function () {",
              "  pm.expect([401, 403]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
